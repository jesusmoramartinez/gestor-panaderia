// Modelo de datos. Este archivo es la fuente de verdad del esquema:
// `prisma migrate dev` compara este archivo con la base y genera el SQL.
//
// Convención del proyecto (ver CLAUDE.md):
//   - acá los modelos van en PascalCase singular (Empresa, UsuarioSucursal)
//   - en la base, las tablas y columnas van en snake_case (@@map y @map)
// Así el código TypeScript se lee natural y el SQL también.

generator client {
  // "prisma-client" es el generador nuevo de Prisma 7: genera código ESM
  // y pide que le digas dónde ponerlo (antes escribía en node_modules).
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL NO va acá: Prisma 7 la toma de prisma.config.ts, que la lee del .env
  // de la raíz del repositorio.
}

/// Roles del sistema. Son fijos (ver decisión en PLAN.md 3.1): con tres roles,
/// una matriz de permisos en código es más simple y más fácil de testear que
/// dos tablas, y no se puede desincronizar con la base.
enum RolUsuario {
  DUENO
  ENCARGADO
  EMPLEADO

  @@map("rol_usuario")
}

/// El "inquilino" del sistema (tenant). Es la raíz del aislamiento
/// multi-empresa: cuando el sistema se venda a otra panadería, se crea otra
/// fila acá y sus datos jamás se cruzan con los de esta.
model Empresa {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  razonSocial     String? @map("razon_social")
  cuit            String?
  /// Para mostrar las fechas. Se guardan en UTC, se muestran en esta zona.
  zonaHoraria     String  @default("America/Argentina/Buenos_Aires") @map("zona_horaria")
  moneda          String  @default("ARS")
  /// Si el IVA es parte del costo del inventario. Depende de la condición
  /// fiscal del cliente: pregunta C-11 de PLAN.md.
  costoIncluyeIva Boolean @default(true) @map("costo_incluye_iva")
  activa          Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sucursales Sucursal[]
  usuarios   Usuario[]
  auditorias Auditoria[]
  unidades   UnidadMedida[]
  categorias CategoriaInsumo[]
  insumos    Insumo[]

  @@map("empresa")
}

/// Un local físico. El stock pertenece a una sucursal, nunca a la empresa:
/// de acá van a colgar los movimientos, los mínimos y las transferencias.
model Sucursal {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  nombre    String
  /// Código corto para los documentos (CEN, LAF).
  codigo    String
  direccion String?
  telefono  String?
  /// Marca la sucursal que produce y abastece a las demás. Hoy es informativo;
  /// lo va a usar el módulo de producción y la venta mayorista.
  esCentral Boolean @default(false) @map("es_central")
  activa    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // onDelete: Restrict → la base impide borrar una empresa que tenga
  // sucursales. En este sistema no borramos nada (desactivamos), así que esto
  // es una red de seguridad contra un borrado accidental.
  empresa         Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarios        UsuarioSucursal[]
  insumoSucursals InsumoSucursal[]

  // La unicidad SIEMPRE empieza por empresa_id: dos panaderías distintas
  // pueden tener una sucursal con el mismo código.
  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("sucursal")
}

/// Una persona que usa el sistema. Pertenece a UNA empresa y tiene UN rol
/// (decisión 3 de PLAN.md).
model Usuario {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String     @map("empresa_id") @db.Uuid
  /// Único a nivel global, no por empresa: si el mismo email existiera en dos
  /// empresas, al loguearse habría que preguntar "¿en cuál querés entrar?".
  /// Se guarda siempre en minúsculas; la normalización la hace la capa de
  /// aplicación al crear o loguear usuarios (Fase 2). Postgres distingue
  /// mayúsculas, así que sin normalizar podrían existir dos cuentas que para
  /// una persona son la misma.
  email          String     @unique
  nombre         String
  /// NUNCA la contraseña: solo su hash (transformación irreversible). Si te
  /// roban la base, no tienen las contraseñas.
  passwordHash   String     @map("password_hash")
  rol            RolUsuario
  activo         Boolean    @default(true)
  ultimoAccesoAt DateTime?  @map("ultimo_acceso_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa    Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursales UsuarioSucursal[]
  sesiones   Sesion[]
  auditorias Auditoria[]

  @@index([empresaId])
  @@map("usuario")
}

/// En qué sucursales puede operar cada usuario.
///
/// Es una relación MUCHOS A MUCHOS (un usuario puede estar en varias
/// sucursales; una sucursal tiene varios usuarios), y en SQL eso siempre se
/// modela con una tabla puente.
///
/// Regla: el rol DUENO accede a todas las sucursales de su empresa sin
/// necesidad de filas acá (lo resuelve el middleware de permisos, Fase 2).
model UsuarioSucursal {
  usuarioId  String @map("usuario_id") @db.Uuid
  sucursalId String @map("sucursal_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // onDelete: Cascade → si se borra el usuario, sus asignaciones se van con
  // él. Acá SÍ corresponde: una asignación no es un registro histórico, es
  // configuración vigente. (Compará con onDelete: Restrict de arriba.)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  // Clave primaria COMPUESTA: la identidad de la fila la dan las dos columnas
  // juntas, así el mismo usuario no puede estar dos veces en la misma sucursal.
  @@id([usuarioId, sucursalId])
  @@index([sucursalId])
  @@map("usuario_sucursal")
}

/// Qué se registró en la auditoría. Crece a medida que aparecen operaciones
/// nuevas en cada fase.
enum AccionAuditoria {
  CREAR
  ACTUALIZAR
  DESACTIVAR
  ANULAR
  LOGIN
  LOGIN_FALLIDO
  LOGOUT

  @@map("accion_auditoria")
}

/// Una sesión activa (un login).
///
/// ¿Por qué una tabla y no solo un JWT firmado? Porque un JWT es válido hasta
/// que vence y NO se puede cancelar: si echás a un empleado, su token sigue
/// funcionando. Con la sesión en una fila, se revoca y listo. El costo es una
/// consulta por pedido, irrelevante para una panadería.
///
/// NOTA sobre la regla de empresa_id: esta tabla NO la lleva, y es a propósito.
/// La regla vale para las tablas de NEGOCIO; `sesion` es infraestructura, se
/// consulta siempre por token y su empresa se deduce del usuario. Agregar la
/// columna sería un dato duplicado que puede quedar desincronizado.
model Sesion {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid

  /// El HASH del token, nunca el token. Mismo razonamiento que la contraseña:
  /// si alguien lee esta tabla, no puede hacerse pasar por nadie.
  /// Acá alcanza SHA-256 (rápido) y no scrypt: el token son 256 bits
  /// aleatorios, así que no hay nada que adivinar por fuerza bruta. El hash
  /// lento se usa cuando el secreto lo eligió una persona.
  tokenHash String @unique @map("token_hash")

  expiraAt    DateTime  @map("expira_at") @db.Timestamptz(6)
  /// Logout, o "cerrar sesión en todos los dispositivos".
  revocadaAt  DateTime? @map("revocada_at") @db.Timestamptz(6)
  ultimoUsoAt DateTime? @map("ultimo_uso_at") @db.Timestamptz(6)

  /// Para el historial de accesos (¿desde dónde entró?).
  ip        String?
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraAt])
  @@map("sesion")
}

/// Quién cambió qué y cuándo.
///
/// Cubre lo que SÍ se puede modificar: catálogos, precios, usuarios,
/// anulaciones y los accesos. Los movimientos de stock no se auditan acá
/// porque ya son inmutables y llevan su propio usuario y fecha.
model Auditoria {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// NULLABLE a propósito: un intento de login con un email que no existe no
  /// pertenece a ninguna empresa, y ese intento igual hay que registrarlo.
  empresaId String? @map("empresa_id") @db.Uuid
  usuarioId String? @map("usuario_id") @db.Uuid

  /// Qué tipo de cosa se tocó: 'usuario', 'insumo', 'recepcion_compra'...
  entidad   String
  /// El id de esa cosa. Nullable porque algunos eventos (un login fallido) no
  /// apuntan a ninguna fila. Es una referencia POLIMÓRFICA: no puede tener
  /// clave foránea, porque apunta a tablas distintas según el caso.
  entidadId String?         @map("entidad_id") @db.Uuid
  accion    AccionAuditoria

  /// Foto del registro antes y después. jsonb es el tipo de Postgres para
  /// guardar JSON consultable.
  datosAntes   Json? @map("datos_antes")
  datosDespues Json? @map("datos_despues")

  ip String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // onDelete: Restrict, no SetNull. Con SetNull, borrar un usuario dejaría
  // todo su historial de auditoría sin autor: una forma de tapar el rastro.
  // Con Restrict, la base impide borrar a quien tenga auditoría. En este
  // sistema los usuarios no se borran, se desactivan (activo = false).
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([empresaId, createdAt])
  @@index([entidad, entidadId])
  @@map("auditoria")
}

/// Familia de unidades. Solo se convierte DENTRO de una misma dimensión:
/// no existe conversión entre PESO y VOLUMEN porque dependería de la densidad
/// del material (1 litro de agua pesa 1 kg; de aceite, ~0,92 kg).
enum DimensionUnidad {
  PESO
  VOLUMEN
  UNIDAD

  @@map("dimension_unidad")
}

/// Catálogo de unidades de medida.
///
/// Cada empresa tiene el suyo: el seed carga las básicas (kg, g, l, ml, u) y
/// mañana una panadería podría agregar la que necesite.
model UnidadMedida {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String          @map("empresa_id") @db.Uuid
  /// Corto, es lo que se ve en los formularios: kg, g, l, ml, u.
  codigo    String
  nombre    String
  dimension DimensionUnidad

  /// Cuánto vale 1 de esta unidad expresado en la unidad BASE de su dimensión.
  /// kg = 1, g = 0.001. Con 10 decimales: un factor con poca precisión
  /// arrastraría el error a todas las cantidades convertidas.
  factorABase Decimal @map("factor_a_base") @db.Decimal(20, 10)

  /// La unidad de referencia de su dimensión (factor 1). Hay una sola por
  /// dimensión y por empresa; lo garantiza un índice único parcial que se
  /// agregó a mano en la migración.
  esBase Boolean @default(false) @map("es_base")
  activa Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  insumos Insumo[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("unidad_medida")
}

/// Agrupa insumos para listar, filtrar y ordenar la lista de compras:
/// harinas, lácteos, envases. Sin jerarquía a propósito: no hace falta y
/// complicaría todas las consultas.
model CategoriaInsumo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  nombre    String
  activa    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  insumos Insumo[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("categoria_insumo")
}

/// Materia prima o material que se compra y se consume.
///
/// El centro del catálogo. De acá van a colgar los movimientos de stock
/// (Fase 6), las compras (Fase 8) y las transferencias (Fase 9).
model Insumo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  /// Código interno, opcional: muchas panaderías identifican por nombre.
  codigo    String?
  nombre    String

  categoriaId String? @map("categoria_id") @db.Uuid

  /// LA UNIDAD EN LA QUE SE LLEVA EL STOCK, SIEMPRE.
  ///
  /// Es la decisión que hace que el kardex funcione: todo movimiento se guarda
  /// convertido a esta unidad. Si un movimiento estuviera en bolsas, otro en kg
  /// y otro en gramos, sumarlos exigiría convertir en cada consulta.
  ///
  /// Por eso NO se puede cambiar desde la edición normal: cambiarla
  /// reinterpretaría todo el historial (los 100 "kg" pasarían a ser 100 "g").
  /// El esquema de actualización simplemente no acepta este campo.
  unidadBaseId String @map("unidad_base_id") @db.Uuid

  activo Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa        Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  categoria      CategoriaInsumo?     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidadBase     UnidadMedida         @relation(fields: [unidadBaseId], references: [id], onDelete: Restrict)
  presentaciones PresentacionInsumo[]
  porSucursal    InsumoSucursal[]

  // Nombre único por empresa: dos filas "Harina 000" partirían el stock en dos
  // sin que nadie se dé cuenta.
  @@unique([empresaId, nombre])
  @@unique([empresaId, codigo])
  @@index([empresaId, activo])
  @@index([categoriaId])
  @@map("insumo")
}

/// Cómo se COMPRA un insumo: "Bolsa 25 kg", "Cajón 12 u", "Bidón 10 l".
///
/// Resuelve el pedido del cliente: compro en bolsas de 25 kg y el stock se
/// lleva en kg. Es una tabla y no un campo del insumo porque un mismo insumo
/// se compra en varias presentaciones a la vez (bolsa de 25 y de 50).
model PresentacionInsumo {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String @map("empresa_id") @db.Uuid
  insumoId  String @map("insumo_id") @db.Uuid
  nombre    String

  /// Cuántas unidades BASE DEL INSUMO trae. Bolsa de 25 kg → 25.
  ///
  /// Cuando un documento usa esta presentación, COPIA este número en su propia
  /// línea (factor_conversion). Si mañana alguien corrige la presentación de
  /// 25 a 24, las compras del año pasado no deben cambiar.
  cantidadBase Decimal @map("cantidad_base") @db.Decimal(18, 6)

  /// La que se propone al comprar. Hay una sola por insumo; lo garantiza un
  /// índice único parcial agregado a mano en la migración.
  esDefault Boolean @default(false) @map("es_default")
  activa    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  insumo Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@unique([insumoId, nombre])
  @@index([insumoId])
  @@map("presentacion_insumo")
}

/// Parámetros de un insumo EN una sucursal.
///
/// El stock mínimo depende de la sucursal: la central guarda 300 kg de harina
/// y la otra 50. Es exactamente lo que pidió el cliente.
///
/// OJO: acá NO hay una columna `stock_actual`, y es a propósito. El saldo no se
/// guarda: se calcula sumando los movimientos (Fase 6). Esta tabla guarda solo
/// lo que CONFIGURA una persona.
model InsumoSucursal {
  insumoId   String @map("insumo_id") @db.Uuid
  sucursalId String @map("sucursal_id") @db.Uuid
  empresaId  String @map("empresa_id") @db.Uuid

  /// En unidad base. Por debajo de esto, el insumo aparece en las alertas.
  stockMinimo Decimal  @default(0) @map("stock_minimo") @db.Decimal(18, 6)
  /// Para sugerir CUÁNTO reponer, no solo qué. Opcional.
  stockMaximo Decimal? @map("stock_maximo") @db.Decimal(18, 6)
  /// "Depósito B, estante 3". Ayuda al que cuenta.
  ubicacion   String?

  /// Un insumo puede no usarse en una sucursal.
  activo Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  insumo   Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([insumoId, sucursalId])
  @@index([empresaId, sucursalId])
  @@map("insumo_sucursal")
}
