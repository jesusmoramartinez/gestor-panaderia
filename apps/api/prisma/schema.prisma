// Modelo de datos. Este archivo es la fuente de verdad del esquema:
// `prisma migrate dev` compara este archivo con la base y genera el SQL.
//
// Convención del proyecto (ver CLAUDE.md):
//   - acá los modelos van en PascalCase singular (Empresa, UsuarioSucursal)
//   - en la base, las tablas y columnas van en snake_case (@@map y @map)
// Así el código TypeScript se lee natural y el SQL también.

generator client {
  // "prisma-client" es el generador nuevo de Prisma 7: genera código ESM
  // y pide que le digas dónde ponerlo (antes escribía en node_modules).
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL NO va acá: Prisma 7 la toma de prisma.config.ts, que la lee del .env
  // de la raíz del repositorio.
}

/// Roles del sistema. Son fijos (ver decisión en PLAN.md 3.1): con tres roles,
/// una matriz de permisos en código es más simple y más fácil de testear que
/// dos tablas, y no se puede desincronizar con la base.
enum RolUsuario {
  DUENO
  ENCARGADO
  EMPLEADO

  @@map("rol_usuario")
}

/// El "inquilino" del sistema (tenant). Es la raíz del aislamiento
/// multi-empresa: cuando el sistema se venda a otra panadería, se crea otra
/// fila acá y sus datos jamás se cruzan con los de esta.
model Empresa {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  razonSocial     String? @map("razon_social")
  cuit            String?
  /// Para mostrar las fechas. Se guardan en UTC, se muestran en esta zona.
  zonaHoraria     String  @default("America/Argentina/Buenos_Aires") @map("zona_horaria")
  moneda          String  @default("ARS")
  /// Si el IVA es parte del costo del inventario. Depende de la condición
  /// fiscal del cliente: pregunta C-11 de PLAN.md.
  costoIncluyeIva Boolean @default(true) @map("costo_incluye_iva")
  activa          Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sucursales     Sucursal[]
  usuarios       Usuario[]
  auditorias     Auditoria[]
  unidades       UnidadMedida[]
  categorias     CategoriaInsumo[]
  insumos        Insumo[]
  proveedores    Proveedor[]
  motivos        MotivoMovimiento[]
  movimientos    MovimientoStock[]
  contadores     ContadorDocumento[]
  ordenes        OrdenCompra[]
  recepciones    RecepcionCompra[]
  plantillas     PlantillaPedido[]
  transferencias Transferencia[]

  @@map("empresa")
}

/// Un local físico. El stock pertenece a una sucursal, nunca a la empresa:
/// de acá van a colgar los movimientos, los mínimos y las transferencias.
model Sucursal {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  nombre    String
  /// Código corto para los documentos (CEN, LAF).
  codigo    String
  direccion String?
  telefono  String?
  /// Marca la sucursal que produce y abastece a las demás. Hoy es informativo;
  /// lo va a usar el módulo de producción y la venta mayorista.
  esCentral Boolean @default(false) @map("es_central")
  activa    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // onDelete: Restrict → la base impide borrar una empresa que tenga
  // sucursales. En este sistema no borramos nada (desactivamos), así que esto
  // es una red de seguridad contra un borrado accidental.
  empresa                 Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarios                UsuarioSucursal[]
  insumoSucursals         InsumoSucursal[]
  movimientos             MovimientoStock[]
  ordenes                 OrdenCompra[]
  recepciones             RecepcionCompra[]
  plantillas              PlantillaPedido[]
  // Dos relaciones con la misma tabla: de dónde sale y a dónde llega.
  transferenciasSalientes Transferencia[]   @relation("TransferenciaOrigen")
  transferenciasEntrantes Transferencia[]   @relation("TransferenciaDestino")

  // La unicidad SIEMPRE empieza por empresa_id: dos panaderías distintas
  // pueden tener una sucursal con el mismo código.
  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("sucursal")
}

/// Una persona que usa el sistema. Pertenece a UNA empresa y tiene UN rol
/// (decisión 3 de PLAN.md).
model Usuario {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String     @map("empresa_id") @db.Uuid
  /// Único a nivel global, no por empresa: si el mismo email existiera en dos
  /// empresas, al loguearse habría que preguntar "¿en cuál querés entrar?".
  /// Se guarda siempre en minúsculas; la normalización la hace la capa de
  /// aplicación al crear o loguear usuarios (Fase 2). Postgres distingue
  /// mayúsculas, así que sin normalizar podrían existir dos cuentas que para
  /// una persona son la misma.
  email          String     @unique
  nombre         String
  /// NUNCA la contraseña: solo su hash (transformación irreversible). Si te
  /// roban la base, no tienen las contraseñas.
  passwordHash   String     @map("password_hash")
  rol            RolUsuario
  activo         Boolean    @default(true)
  ultimoAccesoAt DateTime?  @map("ultimo_acceso_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa                 Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursales              UsuarioSucursal[]
  sesiones                Sesion[]
  auditorias              Auditoria[]
  movimientos             MovimientoStock[]
  ordenes                 OrdenCompra[]
  recepciones             RecepcionCompra[] @relation("RecepcionCargadaPor")
  anulaciones             RecepcionCompra[] @relation("RecepcionAnuladaPor")
  transferenciasEnviadas  Transferencia[]   @relation("TransferenciaEnviadaPor")
  transferenciasRecibidas Transferencia[]   @relation("TransferenciaRecibidaPor")
  transferenciasAnuladas  Transferencia[]   @relation("TransferenciaAnuladaPor")

  @@index([empresaId])
  @@map("usuario")
}

/// En qué sucursales puede operar cada usuario.
///
/// Es una relación MUCHOS A MUCHOS (un usuario puede estar en varias
/// sucursales; una sucursal tiene varios usuarios), y en SQL eso siempre se
/// modela con una tabla puente.
///
/// Regla: el rol DUENO accede a todas las sucursales de su empresa sin
/// necesidad de filas acá (lo resuelve el middleware de permisos, Fase 2).
model UsuarioSucursal {
  usuarioId  String @map("usuario_id") @db.Uuid
  sucursalId String @map("sucursal_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // onDelete: Cascade → si se borra el usuario, sus asignaciones se van con
  // él. Acá SÍ corresponde: una asignación no es un registro histórico, es
  // configuración vigente. (Compará con onDelete: Restrict de arriba.)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  // Clave primaria COMPUESTA: la identidad de la fila la dan las dos columnas
  // juntas, así el mismo usuario no puede estar dos veces en la misma sucursal.
  @@id([usuarioId, sucursalId])
  @@index([sucursalId])
  @@map("usuario_sucursal")
}

/// Qué se registró en la auditoría. Crece a medida que aparecen operaciones
/// nuevas en cada fase.
enum AccionAuditoria {
  CREAR
  ACTUALIZAR
  DESACTIVAR
  ANULAR
  LOGIN
  LOGIN_FALLIDO
  LOGOUT
  /// Alguien dejó el stock en negativo a propósito, usando su permiso
  /// especial. Es una de las dos operaciones peligrosas del sistema (la otra
  /// es anular), así que tiene su propia acción y se puede consultar:
  /// "¿cuántas veces se forzó este mes, y quién?".
  FORZAR_STOCK_NEGATIVO

  @@map("accion_auditoria")
}

/// Una sesión activa (un login).
///
/// ¿Por qué una tabla y no solo un JWT firmado? Porque un JWT es válido hasta
/// que vence y NO se puede cancelar: si echás a un empleado, su token sigue
/// funcionando. Con la sesión en una fila, se revoca y listo. El costo es una
/// consulta por pedido, irrelevante para una panadería.
///
/// NOTA sobre la regla de empresa_id: esta tabla NO la lleva, y es a propósito.
/// La regla vale para las tablas de NEGOCIO; `sesion` es infraestructura, se
/// consulta siempre por token y su empresa se deduce del usuario. Agregar la
/// columna sería un dato duplicado que puede quedar desincronizado.
model Sesion {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid

  /// El HASH del token, nunca el token. Mismo razonamiento que la contraseña:
  /// si alguien lee esta tabla, no puede hacerse pasar por nadie.
  /// Acá alcanza SHA-256 (rápido) y no scrypt: el token son 256 bits
  /// aleatorios, así que no hay nada que adivinar por fuerza bruta. El hash
  /// lento se usa cuando el secreto lo eligió una persona.
  tokenHash String @unique @map("token_hash")

  expiraAt    DateTime  @map("expira_at") @db.Timestamptz(6)
  /// Logout, o "cerrar sesión en todos los dispositivos".
  revocadaAt  DateTime? @map("revocada_at") @db.Timestamptz(6)
  ultimoUsoAt DateTime? @map("ultimo_uso_at") @db.Timestamptz(6)

  /// Para el historial de accesos (¿desde dónde entró?).
  ip        String?
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraAt])
  @@map("sesion")
}

/// Quién cambió qué y cuándo.
///
/// Cubre lo que SÍ se puede modificar: catálogos, precios, usuarios,
/// anulaciones y los accesos. Los movimientos de stock no se auditan acá
/// porque ya son inmutables y llevan su propio usuario y fecha.
model Auditoria {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// NULLABLE a propósito: un intento de login con un email que no existe no
  /// pertenece a ninguna empresa, y ese intento igual hay que registrarlo.
  empresaId String? @map("empresa_id") @db.Uuid
  usuarioId String? @map("usuario_id") @db.Uuid

  /// Qué tipo de cosa se tocó: 'usuario', 'insumo', 'recepcion_compra'...
  entidad   String
  /// El id de esa cosa. Nullable porque algunos eventos (un login fallido) no
  /// apuntan a ninguna fila. Es una referencia POLIMÓRFICA: no puede tener
  /// clave foránea, porque apunta a tablas distintas según el caso.
  entidadId String?         @map("entidad_id") @db.Uuid
  accion    AccionAuditoria

  /// Foto del registro antes y después. jsonb es el tipo de Postgres para
  /// guardar JSON consultable.
  datosAntes   Json? @map("datos_antes")
  datosDespues Json? @map("datos_despues")

  ip String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // onDelete: Restrict, no SetNull. Con SetNull, borrar un usuario dejaría
  // todo su historial de auditoría sin autor: una forma de tapar el rastro.
  // Con Restrict, la base impide borrar a quien tenga auditoría. En este
  // sistema los usuarios no se borran, se desactivan (activo = false).
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([empresaId, createdAt])
  @@index([entidad, entidadId])
  @@map("auditoria")
}

/// Familia de unidades. Solo se convierte DENTRO de una misma dimensión:
/// no existe conversión entre PESO y VOLUMEN porque dependería de la densidad
/// del material (1 litro de agua pesa 1 kg; de aceite, ~0,92 kg).
enum DimensionUnidad {
  PESO
  VOLUMEN
  UNIDAD

  @@map("dimension_unidad")
}

/// Catálogo de unidades de medida.
///
/// Cada empresa tiene el suyo: el seed carga las básicas (kg, g, l, ml, u) y
/// mañana una panadería podría agregar la que necesite.
model UnidadMedida {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String          @map("empresa_id") @db.Uuid
  /// Corto, es lo que se ve en los formularios: kg, g, l, ml, u.
  codigo    String
  nombre    String
  dimension DimensionUnidad

  /// Cuánto vale 1 de esta unidad expresado en la unidad BASE de su dimensión.
  /// kg = 1, g = 0.001. Con 10 decimales: un factor con poca precisión
  /// arrastraría el error a todas las cantidades convertidas.
  factorABase Decimal @map("factor_a_base") @db.Decimal(20, 10)

  /// La unidad de referencia de su dimensión (factor 1). Hay una sola por
  /// dimensión y por empresa; lo garantiza un índice único parcial que se
  /// agregó a mano en la migración.
  esBase Boolean @default(false) @map("es_base")
  activa Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa             Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  insumos             Insumo[]
  movimientos         MovimientoStock[]
  lineasTransferencia LineaTransferencia[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("unidad_medida")
}

/// Agrupa insumos para listar, filtrar y ordenar la lista de compras:
/// harinas, lácteos, envases. Sin jerarquía a propósito: no hace falta y
/// complicaría todas las consultas.
model CategoriaInsumo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  nombre    String
  activa    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  insumos Insumo[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("categoria_insumo")
}

/// Materia prima o material que se compra y se consume.
///
/// El centro del catálogo. De acá van a colgar los movimientos de stock
/// (Fase 6), las compras (Fase 8) y las transferencias (Fase 9).
model Insumo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  /// Código interno, opcional: muchas panaderías identifican por nombre.
  codigo    String?
  nombre    String

  categoriaId String? @map("categoria_id") @db.Uuid

  /// LA UNIDAD EN LA QUE SE LLEVA EL STOCK, SIEMPRE.
  ///
  /// Es la decisión que hace que el kardex funcione: todo movimiento se guarda
  /// convertido a esta unidad. Si un movimiento estuviera en bolsas, otro en kg
  /// y otro en gramos, sumarlos exigiría convertir en cada consulta.
  ///
  /// Por eso NO se puede cambiar desde la edición normal: cambiarla
  /// reinterpretaría todo el historial (los 100 "kg" pasarían a ser 100 "g").
  /// El esquema de actualización simplemente no acepta este campo.
  unidadBaseId String @map("unidad_base_id") @db.Uuid

  activo Boolean @default(true)

  /// COSTO PROMEDIO PONDERADO por unidad base, para toda la empresa.
  ///
  /// Es un valor DERIVADO, como sería un stock guardado: la verdad está en los
  /// movimientos COMPRA. Por eso nunca se edita a mano ni se le suma o resta:
  /// después de cada recepción (o anulación) se RECONSTRUYE recorriendo los
  /// movimientos con `calcularCostoPromedio`. Null = todavía no hubo ninguna
  /// compra, y el costo es desconocido (que no es lo mismo que cero).
  ///
  /// Es por empresa y no por sucursal (decisión de PLAN.md 3.7).
  costoPromedio Decimal? @map("costo_promedio") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa             Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  categoria           CategoriaInsumo?       @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidadBase          UnidadMedida           @relation(fields: [unidadBaseId], references: [id], onDelete: Restrict)
  presentaciones      PresentacionInsumo[]
  porSucursal         InsumoSucursal[]
  proveedores         ProveedorInsumo[]
  movimientos         MovimientoStock[]
  lineasOrden         LineaOrdenCompra[]
  lineasRecepcion     LineaRecepcionCompra[]
  lineasPlantilla     LineaPlantillaPedido[]
  lineasTransferencia LineaTransferencia[]

  // Nombre único por empresa: dos filas "Harina 000" partirían el stock en dos
  // sin que nadie se dé cuenta.
  @@unique([empresaId, nombre])
  @@unique([empresaId, codigo])
  @@index([empresaId, activo])
  @@index([categoriaId])
  @@map("insumo")
}

/// Cómo se COMPRA un insumo: "Bolsa 25 kg", "Cajón 12 u", "Bidón 10 l".
///
/// Resuelve el pedido del cliente: compro en bolsas de 25 kg y el stock se
/// lleva en kg. Es una tabla y no un campo del insumo porque un mismo insumo
/// se compra en varias presentaciones a la vez (bolsa de 25 y de 50).
model PresentacionInsumo {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String @map("empresa_id") @db.Uuid
  insumoId  String @map("insumo_id") @db.Uuid
  nombre    String

  /// Cuántas unidades BASE DEL INSUMO trae. Bolsa de 25 kg → 25.
  ///
  /// Cuando un documento usa esta presentación, COPIA este número en su propia
  /// línea (factor_conversion). Si mañana alguien corrige la presentación de
  /// 25 a 24, las compras del año pasado no deben cambiar.
  cantidadBase Decimal @map("cantidad_base") @db.Decimal(18, 6)

  /// La que se propone al comprar. Hay una sola por insumo; lo garantiza un
  /// índice único parcial agregado a mano en la migración.
  esDefault Boolean @default(false) @map("es_default")
  activa    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  insumo          Insumo                 @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  proveedores     ProveedorInsumo[]
  lineasOrden     LineaOrdenCompra[]
  lineasRecepcion LineaRecepcionCompra[]
  lineasPlantilla LineaPlantillaPedido[]

  @@unique([insumoId, nombre])
  @@index([insumoId])
  @@map("presentacion_insumo")
}

/// Parámetros de un insumo EN una sucursal.
///
/// El stock mínimo depende de la sucursal: la central guarda 300 kg de harina
/// y la otra 50. Es exactamente lo que pidió el cliente.
///
/// OJO: acá NO hay una columna `stock_actual`, y es a propósito. El saldo no se
/// guarda: se calcula sumando los movimientos (Fase 6). Esta tabla guarda solo
/// lo que CONFIGURA una persona.
model InsumoSucursal {
  insumoId   String @map("insumo_id") @db.Uuid
  sucursalId String @map("sucursal_id") @db.Uuid
  empresaId  String @map("empresa_id") @db.Uuid

  /// En unidad base. Por debajo de esto, el insumo aparece en las alertas.
  stockMinimo Decimal  @default(0) @map("stock_minimo") @db.Decimal(18, 6)
  /// Para sugerir CUÁNTO reponer, no solo qué. Opcional.
  stockMaximo Decimal? @map("stock_maximo") @db.Decimal(18, 6)
  /// "Depósito B, estante 3". Ayuda al que cuenta.
  ubicacion   String?

  /// Un insumo puede no usarse en una sucursal.
  activo Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  insumo   Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([insumoId, sucursalId])
  @@index([empresaId, sucursalId])
  @@map("insumo_sucursal")
}

/// A quién le compramos. Es un catálogo: se da de alta, se corrige y se
/// desactiva, nunca se borra.
///
/// Todavía NO tiene cuenta corriente ni pagos (fuera de alcance). Lo que sí
/// tiene es `diasEntrega`, porque es lo que convierte una alerta de stock bajo
/// en una sugerencia útil: "pedí hoy, que tarda 3 días".
model Proveedor {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String  @map("empresa_id") @db.Uuid
  nombre         String
  /// El nombre legal, que casi nunca es el que usa la gente: se le dice
  /// "Molino Cañuelas" y la factura dice "Compañía Argentina de Granos S.A.".
  razonSocial    String? @map("razon_social")
  cuit           String?
  email          String?
  telefono       String?
  direccion      String?
  contactoNombre String? @map("contacto_nombre")

  /// Cuántos días tarda en entregar desde que se le pide. Entero y nullable:
  /// si no se sabe, es null, que NO es lo mismo que cero (entrega en el día).
  diasEntrega Int?    @map("dias_entrega")
  notas       String?
  activo      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  insumos     ProveedorInsumo[]
  ordenes     OrdenCompra[]
  recepciones RecepcionCompra[]
  plantillas  PlantillaPedido[]

  @@unique([empresaId, nombre])
  @@index([empresaId, activo])
  @@map("proveedor")
}

/// Qué insumo provee cada proveedor: la tabla PUENTE de una relación
/// muchos-a-muchos CON ATRIBUTOS PROPIOS.
///
/// Un proveedor vende muchos insumos y un insumo se le compra a varios
/// proveedores. Eso solo ya pediría una tabla intermedia. Pero acá hay algo
/// más: el precio, el código del artículo en el catálogo del proveedor y en
/// qué presentación lo vende NO pertenecen ni al proveedor ni al insumo por
/// separado — pertenecen al PAR. Esa es la señal de que la relación necesita
/// su propia tabla con sus propias columnas (y no las "relaciones implícitas"
/// de Prisma, que solo guardan los dos ids).
model ProveedorInsumo {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Igual que en presentacion_insumo: la columna va, la clave foránea no.
  /// El empresa_id acá es un dato DERIVADO (sale del proveedor y del insumo,
  /// que ya la tienen) y está para poder filtrar e indexar por empresa sin
  /// hacer dos joins. El servicio es el que garantiza que coincida.
  empresaId   String @map("empresa_id") @db.Uuid
  proveedorId String @map("proveedor_id") @db.Uuid
  insumoId    String @map("insumo_id") @db.Uuid

  /// En qué presentación lo vende. Null = lo vende en la unidad base.
  ///
  /// La base NO puede garantizar que esta presentación sea del mismo insumo
  /// que `insumoId`: una clave foránea simple solo verifica que el id exista
  /// en presentacion_insumo, no de quién es. Por eso es una regla del
  /// SERVICIO, con su test.
  presentacionId String? @map("presentacion_id") @db.Uuid

  /// El código del artículo en SU catálogo, para pedirle sin confusión
  /// ("mandame 10 del 4412").
  codigoProveedor String? @map("codigo_proveedor")

  /// Precio de la presentación (o de la unidad base si no hay presentación) en
  /// la última compra. Lo va a actualizar solo la recepción de compras
  /// (Fase 8); hoy se puede cargar a mano para arrancar.
  ultimoPrecio   Decimal?  @map("ultimo_precio") @db.Decimal(18, 4)
  /// Con inflación, un precio sin fecha no sirve para nada. Los dos van juntos
  /// o no van: lo garantiza un CHECK en la migración.
  ultimoPrecioAt DateTime? @map("ultimo_precio_at") @db.Timestamptz(6)

  /// A quién se le compra este insumo por defecto. Define bajo qué proveedor
  /// se agrupa en la vista de reposición (Fase 10). Hay UNO solo por insumo:
  /// lo garantiza un índice único parcial en la migración.
  esPreferido Boolean @default(false) @map("es_preferido")
  activo      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  proveedor    Proveedor           @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  insumo       Insumo              @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  /// SetNull y no Cascade: si alguna vez se borrara una presentación, la
  /// relación con el proveedor (y su precio) tiene que sobrevivir. Queda en
  /// null, que ya significa algo válido: "lo vende en la unidad base".
  presentacion PresentacionInsumo? @relation(fields: [presentacionId], references: [id], onDelete: SetNull)

  // Un proveedor no puede figurar dos veces para el mismo insumo: si no,
  // habría dos precios "últimos" y ninguno sería el último.
  @@unique([proveedorId, insumoId])
  @@index([empresaId])
  @@index([insumoId])
  @@index([presentacionId])
  @@map("proveedor_insumo")
}

/// A qué tipo de movimiento se le puede poner este motivo.
enum TipoMotivo {
  MERMA
  AJUSTE
  CONSUMO

  @@map("tipo_motivo")
}

/// Por qué se perdió o se ajustó un insumo: "Vencido", "Plaga o humedad".
///
/// Por qué una tabla y no texto libre: si cada uno escribe "vencio",
/// "Vencido" y "venció", nunca se puede responder "¿cuánta plata perdimos por
/// vencimiento este mes?". El campo `notas` del movimiento queda para el
/// detalle libre ("el estante de abajo del depósito B").
model MotivoMovimiento {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String     @map("empresa_id") @db.Uuid
  tipoAplicable TipoMotivo @map("tipo_aplicable")
  nombre        String
  activo        Boolean    @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  movimientos MovimientoStock[]

  // El mismo nombre puede existir para dos tipos distintos ("Error de carga"
  // sirve para una merma y para un ajuste), así que la unicidad incluye el tipo.
  @@unique([empresaId, tipoAplicable, nombre])
  @@index([empresaId, tipoAplicable])
  @@map("motivo_movimiento")
}

/// Qué clase de hecho movió el stock.
///
/// En esta fase se usan SALDO_INICIAL, CONSUMO, MERMA y REVERSA. Los otros
/// cuatro ya están declarados porque el CHECK de signo los nombra y porque el
/// tipo es parte del contrato: agregar un valor a un enum de Postgres más
/// adelante es una migración, y el historial viejo no cambia.
enum TipoMovimiento {
  SALDO_INICIAL
  COMPRA
  CONSUMO
  MERMA
  AJUSTE
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  REVERSA

  @@map("tipo_movimiento")
}

/// LA TABLA MÁS IMPORTANTE DEL PROYECTO.
///
/// No se guarda "cuánto hay": se guardan todos los HECHOS que afectan el
/// stock, y el saldo es su suma. Eso es el patrón kardex, y es exactamente
/// cómo funciona un extracto bancario. La nota completa, con el contraste
/// contra una columna `stock_actual`, está en
/// docs/aprendizaje/03-kardex-stock-calculado.md
///
/// DOS REGLAS QUE NUNCA SE ROMPEN:
///
/// 1. Una fila de esta tabla NO se edita ni se borra. Nunca. Para corregir un
///    error se escribe un movimiento inverso (`REVERSA`). Fijate que este
///    modelo no tiene `updatedAt`, al contrario de todos los demás: no hay
///    nada que actualizar, y su ausencia lo deja dicho en el esquema.
/// 2. Un ÚNICO servicio inserta acá (`registrarMovimientos`). Si hubiera dos,
///    tarde o temprano uno se olvida de una validación, y te enterás por un
///    stock que no cuadra tres semanas después.
model MovimientoStock {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId  String @map("empresa_id") @db.Uuid
  /// Dónde pasó. El stock es de una sucursal, nunca de la empresa.
  sucursalId String @map("sucursal_id") @db.Uuid
  insumoId   String @map("insumo_id") @db.Uuid

  tipo TipoMovimiento

  /// CON SIGNO: positivo entra, negativo sale. Siempre en la unidad base del
  /// insumo.
  ///
  /// Una sola columna con signo (en vez de una cantidad positiva más un campo
  /// "sentido") hace que el saldo sea `SUM(cantidad_base)` y nada más. Con la
  /// otra forma, cada consulta necesitaría un CASE por tipo, y el día que se
  /// agrega un tipo nuevo hay que acordarse de tocar todas: el error sería
  /// silencioso.
  cantidadBase Decimal @map("cantidad_base") @db.Decimal(18, 6)

  /// Lo que la persona TIPEÓ, sin signo, y en qué unidad lo tipeó.
  cantidadIngresada Decimal @map("cantidad_ingresada") @db.Decimal(18, 6)
  unidadIngresadaId String  @map("unidad_ingresada_id") @db.Uuid
  /// SNAPSHOT del factor usado para convertir. Es una copia a propósito: si
  /// mañana alguien corrige el factor de la unidad, este movimiento tiene que
  /// seguir diciendo la verdad de lo que pasó ese día.
  ///
  /// Con estos tres campos el historial puede mostrar "cargó 2000 g = 2 kg" y
  /// va a seguir siendo cierto en cinco años.
  factorConversion  Decimal @map("factor_conversion") @db.Decimal(20, 10)

  /// Costo por unidad base EN EL MOMENTO del movimiento, CONGELADO.
  ///
  ///   - en una COMPRA: lo que costó de verdad (precio ÷ factor);
  ///   - en todo lo demás: el costo promedio del insumo en ese momento, o
  ///     null si todavía no hubo ninguna compra.
  ///
  /// Se congela porque el promedio cambia con cada compra: la merma de marzo
  /// tiene que seguir valiendo lo que valía en marzo.
  costoUnitario Decimal? @map("costo_unitario") @db.Decimal(18, 4)

  /// CUÁNDO OCURRIÓ en la realidad. Es distinto de created_at (cuándo se
  /// registró): una merma del sábado se puede cargar el lunes, y para los
  /// informes vale el sábado.
  fecha     DateTime @db.Timestamptz(6)
  usuarioId String   @map("usuario_id") @db.Uuid

  /// Obligatorio para MERMA y AJUSTE: es una regla del servicio, porque la
  /// base no puede saber qué tipos la necesitan sin repetir la lista.
  motivoId String? @map("motivo_id") @db.Uuid
  notas    String?

  /// Agrupa los movimientos escritos en la MISMA operación: una carga de
  /// consumo con 6 insumos deja 6 filas con el mismo operacion_id. No es
  /// clave foránea (no hay tabla "operación"): es una etiqueta de agrupación,
  /// y es lo que permite anular una carga completa o mostrarla junta.
  operacionId String @map("operacion_id") @db.Uuid

  /// El documento que lo originó: la recepción de compra. Obligatorio en los
  /// movimientos COMPRA (lo exige un CHECK) y también en sus reversas, para
  /// que el historial pueda decir "anulación de la recepción 12".
  recepcionCompraId String? @map("recepcion_compra_id") @db.Uuid
  /// La transferencia que lo originó: su salida, su entrada, la merma por
  /// diferencia o la reversa al anularla. Obligatorio en los dos tipos
  /// TRANSFERENCIA_* (lo exige un CHECK).
  transferenciaId   String? @map("transferencia_id") @db.Uuid

  /// Si este movimiento anula a otro. UNIQUE: un movimiento se puede revertir
  /// UNA sola vez, y eso lo garantiza la base, no la buena memoria del código.
  revierteAId String? @unique @map("revierte_a_id") @db.Uuid

  /// true si se dejó el stock en negativo a propósito, con permiso especial.
  forzado Boolean @default(false)

  /// Cuándo se REGISTRÓ. No hay updatedAt: esta fila no se actualiza.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  empresa         Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal        Sucursal          @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  insumo          Insumo            @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  unidadIngresada UnidadMedida      @relation(fields: [unidadIngresadaId], references: [id], onDelete: Restrict)
  usuario         Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  motivo          MotivoMovimiento? @relation(fields: [motivoId], references: [id], onDelete: Restrict)
  recepcionCompra RecepcionCompra?  @relation(fields: [recepcionCompraId], references: [id], onDelete: Restrict)
  transferencia   Transferencia?    @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)

  // Relación de la tabla CONSIGO MISMA: una reversa apunta al movimiento que
  // anula. Como revierteAId es @unique, Prisma la trata como uno-a-uno, y por
  // eso del otro lado hay un solo `revertidoPor` y no una lista.
  revierteA    MovimientoStock? @relation("Reversa", fields: [revierteAId], references: [id], onDelete: Restrict)
  revertidoPor MovimientoStock? @relation("Reversa")

  // onDelete: Restrict en TODAS las claves foráneas. Un movimiento es un
  // hecho histórico: la base tiene que impedir que borrar un insumo, un
  // usuario o una sucursal se lleve el historial puesto.

  // El índice que usa la consulta de saldo y la de historial. El orden de las
  // columnas importa: Postgres puede usar un índice si la consulta filtra por
  // un PREFIJO de sus columnas, así que este también sirve para
  // (empresa, sucursal) y para (empresa, sucursal, insumo).
  @@index([empresaId, sucursalId, insumoId, fecha])
  // Para la valuación y el recálculo del costo promedio (Fase 8): el mismo
  // insumo en TODAS las sucursales.
  @@index([empresaId, insumoId, fecha])
  // Para traer o anular una operación completa.
  @@index([operacionId])
  @@index([recepcionCompraId])
  @@index([transferenciaId])
  @@map("movimiento_stock")
}

// ===========================================================================
// FASE 8 — Compras: orden, recepción y costo promedio
// ===========================================================================

/// Qué documentos llevan número correlativo.
enum TipoDocumento {
  ORDEN_COMPRA
  RECEPCION_COMPRA
  TRANSFERENCIA

  @@map("tipo_documento")
}

/// El último número usado de cada tipo de documento, por empresa.
///
/// POR QUÉ UNA TABLA Y NO `MAX(numero) + 1`: si dos personas confirman una
/// recepción en el mismo instante, las dos leen el mismo máximo y las dos
/// generan el número 15. Es la misma condición de carrera que el stock
/// negativo, y se resuelve igual: con el candado de una fila. Ver
/// `siguienteNumero` en el módulo de compras.
model ContadorDocumento {
  empresaId     String        @map("empresa_id") @db.Uuid
  tipoDocumento TipoDocumento @map("tipo_documento")
  ultimoNumero  Int           @default(0) @map("ultimo_numero")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  // Clave primaria COMPUESTA: hay una sola fila por empresa y tipo, y por eso
  // el candado de esa fila es "el" candado de la numeración.
  @@id([empresaId, tipoDocumento])
  @@map("contador_documento")
}

/// Los estados de una orden de compra. La máquina de estados (qué se puede
/// hacer desde cada uno) está en packages/shared/src/dominio/compras.ts.
enum EstadoOrdenCompra {
  BORRADOR
  PEDIDA
  PARCIAL
  RECIBIDA
  CERRADA
  CANCELADA

  @@map("estado_orden_compra")
}

/// Lo que se le PIDE al proveedor. NO mueve stock: pedir no es tener.
///
/// Es opcional: una recepción puede existir sin orden (recepción directa),
/// porque muchas compras se hacen por teléfono y llegan el mismo día.
model OrdenCompra {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String            @map("empresa_id") @db.Uuid
  /// La sucursal que va a RECIBIR la mercadería.
  sucursalId  String            @map("sucursal_id") @db.Uuid
  proveedorId String            @map("proveedor_id") @db.Uuid
  /// Correlativo por empresa: "OC 15". Lo asigna el contador de documentos.
  numero      Int
  estado      EstadoOrdenCompra

  /// Un DÍA de calendario ("llega el jueves"), no un instante: por eso es
  /// `date` y no `timestamptz`. La regla "fechas en UTC" es para instantes;
  /// un día no tiene hora, y guardarlo como medianoche UTC lo haría caer en el
  /// miércoles a las 21 h de Argentina.
  fechaEntregaEstimada DateTime? @map("fecha_entrega_estimada") @db.Date
  notas                String?
  usuarioId            String    @map("usuario_id") @db.Uuid

  /// Cuándo se le pidió al proveedor. Null mientras es borrador.
  pedidaAt   DateTime? @map("pedida_at") @db.Timestamptz(6)
  /// Cuándo se cerró con faltante o se canceló, y por qué.
  cerradaAt  DateTime? @map("cerrada_at") @db.Timestamptz(6)
  notaCierre String?   @map("nota_cierre")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa     Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal    Sucursal           @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  proveedor   Proveedor          @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  usuario     Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  lineas      LineaOrdenCompra[]
  recepciones RecepcionCompra[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@index([empresaId, sucursalId])
  @@index([proveedorId])
  @@map("orden_compra")
}

/// Una línea de la orden: "10 bolsas de 25 kg de Harina 000 a $18.500".
///
/// NO tiene `cantidad_recibida`, y es a propósito: lo recibido se CALCULA
/// sumando las recepciones confirmadas de esta línea. Misma filosofía que el
/// stock: un solo lugar con la verdad. Si hubiera una columna, anular una
/// recepción obligaría a acordarse de restarla, y el día que alguien se olvide
/// la orden diría "recibida" con la mercadería devuelta.
model LineaOrdenCompra {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Columna sin clave foránea, igual que en presentacion_insumo: es un dato
  /// derivado (sale de la orden) que está para filtrar sin un join.
  empresaId      String  @map("empresa_id") @db.Uuid
  ordenCompraId  String  @map("orden_compra_id") @db.Uuid
  insumoId       String  @map("insumo_id") @db.Uuid
  /// Null = se pide en la unidad base del insumo.
  presentacionId String? @map("presentacion_id") @db.Uuid

  /// En presentaciones: 10 (bolsas).
  cantidad         Decimal  @db.Decimal(18, 6)
  /// SNAPSHOT de cuánto trae la presentación HOY: 25. Si mañana alguien la
  /// corrige a 24, esta orden tiene que seguir diciendo lo que se pidió.
  factorConversion Decimal  @map("factor_conversion") @db.Decimal(20, 10)
  /// cantidad × factor = 250 kg. Es con lo que se compara lo recibido.
  cantidadBase     Decimal  @map("cantidad_base") @db.Decimal(18, 6)
  /// Precio de UNA presentación. Nullable: se puede pedir sin saber el precio,
  /// y se carga al recibir (respuesta C-9 del cliente).
  precioUnitario   Decimal? @map("precio_unitario") @db.Decimal(18, 4)

  orden        OrdenCompra            @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  insumo       Insumo                 @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  presentacion PresentacionInsumo?    @relation(fields: [presentacionId], references: [id], onDelete: Restrict)
  recepciones  LineaRecepcionCompra[]

  // Un insumo una sola vez por orden: si estuviera dos veces, "cuánto falta"
  // de la harina tendría dos respuestas.
  @@unique([ordenCompraId, insumoId])
  @@index([insumoId])
  @@map("linea_orden_compra")
}

enum EstadoRecepcion {
  CONFIRMADA
  ANULADA

  @@map("estado_recepcion")
}

/// La LLEGADA efectiva de mercadería. Esto sí mueve stock.
///
/// Se confirma al guardarla (no tiene borrador): lo que llegó, llegó. Si se
/// cargó mal, se ANULA, y la anulación escribe las reversas de sus
/// movimientos. Nunca se edita ni se borra, igual que un movimiento.
model RecepcionCompra {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String          @map("empresa_id") @db.Uuid
  sucursalId    String          @map("sucursal_id") @db.Uuid
  proveedorId   String          @map("proveedor_id") @db.Uuid
  /// Null = recepción DIRECTA, sin orden previa.
  ordenCompraId String?         @map("orden_compra_id") @db.Uuid
  numero        Int
  /// Cuándo llegó en la realidad (puede cargarse después).
  fecha         DateTime        @db.Timestamptz(6)
  /// El papel que trajo el repartidor, para poder cruzarlo.
  numeroRemito  String?         @map("numero_remito")
  numeroFactura String?         @map("numero_factura")
  notas         String?
  estado        EstadoRecepcion @default(CONFIRMADA)
  usuarioId     String          @map("usuario_id") @db.Uuid
  /// El operacion_id de los movimientos COMPRA que escribió.
  operacionId   String          @map("operacion_id") @db.Uuid

  anuladaAt       DateTime? @map("anulada_at") @db.Timestamptz(6)
  anuladaPorId    String?   @map("anulada_por_id") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa     Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  sucursal    Sucursal               @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  proveedor   Proveedor              @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  orden       OrdenCompra?           @relation(fields: [ordenCompraId], references: [id], onDelete: Restrict)
  // Dos relaciones con la MISMA tabla (usuario): quién la cargó y quién la
  // anuló. Prisma necesita un nombre para distinguirlas.
  usuario     Usuario                @relation("RecepcionCargadaPor", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladaPor  Usuario?               @relation("RecepcionAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  lineas      LineaRecepcionCompra[]
  movimientos MovimientoStock[]

  @@unique([empresaId, numero])
  @@index([empresaId, sucursalId, fecha])
  @@index([ordenCompraId])
  @@index([proveedorId])
  @@map("recepcion_compra")
}

/// Una línea de la recepción: lo que llegó de UN insumo, y a qué precio.
model LineaRecepcionCompra {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String  @map("empresa_id") @db.Uuid
  recepcionCompraId  String  @map("recepcion_compra_id") @db.Uuid
  /// Qué línea de la orden cumple. Null en una recepción directa.
  lineaOrdenCompraId String? @map("linea_orden_compra_id") @db.Uuid
  insumoId           String  @map("insumo_id") @db.Uuid
  presentacionId     String? @map("presentacion_id") @db.Uuid

  cantidad          Decimal @db.Decimal(18, 6)
  factorConversion  Decimal @map("factor_conversion") @db.Decimal(20, 10)
  cantidadBase      Decimal @map("cantidad_base") @db.Decimal(18, 6)
  /// Lo que se pagó por UNA presentación. Obligatorio: el precio se carga en
  /// cada compra (respuesta C-7 del cliente).
  precioUnitario    Decimal @map("precio_unitario") @db.Decimal(18, 4)
  /// precio ÷ factor: lo que costó UNA unidad base. $25.000 / 25 = $1.000/kg.
  /// Es el número que entra al costo promedio.
  costoUnitarioBase Decimal @map("costo_unitario_base") @db.Decimal(18, 4)

  recepcion    RecepcionCompra     @relation(fields: [recepcionCompraId], references: [id], onDelete: Restrict)
  lineaOrden   LineaOrdenCompra?   @relation(fields: [lineaOrdenCompraId], references: [id], onDelete: Restrict)
  insumo       Insumo              @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  presentacion PresentacionInsumo? @relation(fields: [presentacionId], references: [id], onDelete: Restrict)

  @@unique([recepcionCompraId, insumoId])
  @@index([lineaOrdenCompraId])
  @@index([insumoId])
  @@map("linea_recepcion_compra")
}

/// Un pedido que se repite, guardado con nombre: "Pedido semanal Molino".
///
/// Pedido del cliente: hay pedidos recurrentes, y armarlos de cero cada lunes
/// es justo el trabajo que el sistema le tiene que ahorrar al dueño. La
/// plantilla NO se gasta al usarla: precarga una orden nueva y sigue ahí.
///
/// No guarda precios, a propósito: con inflación, el precio de la plantilla
/// estaría viejo a la segunda semana. Al usarla, el precio se sugiere desde el
/// último que se pagó (`proveedor_insumo.ultimo_precio`).
model PlantillaPedido {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String  @map("empresa_id") @db.Uuid
  nombre      String
  proveedorId String  @map("proveedor_id") @db.Uuid
  sucursalId  String  @map("sucursal_id") @db.Uuid
  notas       String?
  activa      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa   Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  proveedor Proveedor              @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  sucursal  Sucursal               @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  lineas    LineaPlantillaPedido[]

  @@unique([empresaId, nombre])
  @@index([empresaId, activa])
  @@map("plantilla_pedido")
}

model LineaPlantillaPedido {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String  @map("empresa_id") @db.Uuid
  plantillaId    String  @map("plantilla_id") @db.Uuid
  insumoId       String  @map("insumo_id") @db.Uuid
  presentacionId String? @map("presentacion_id") @db.Uuid
  /// En presentaciones, igual que en la orden.
  cantidad       Decimal @db.Decimal(18, 6)

  plantilla    PlantillaPedido     @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  insumo       Insumo              @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  presentacion PresentacionInsumo? @relation(fields: [presentacionId], references: [id], onDelete: Restrict)

  @@unique([plantillaId, insumoId])
  @@index([insumoId])
  @@map("linea_plantilla_pedido")
}

// ===========================================================================
// FASE 9 — Transferencias entre sucursales
// ===========================================================================

enum EstadoTransferencia {
  /// Salió del origen y todavía no llegó: está EN TRÁNSITO.
  ENVIADA
  RECIBIDA
  ANULADA

  @@map("estado_transferencia")
}

/// Un envío de insumos de una sucursal a otra.
///
/// Son DOS hechos, hechos por dos personas en dos lugares: enviar (sale del
/// origen) y recibir (entra al destino). Entre medio, la mercadería está en
/// tránsito: ya no está en el stock del origen y todavía no está en el del
/// destino. Eso es correcto, es la realidad física: va en la camioneta.
///
/// Es un movimiento INTERNO, al costo: las dos sucursales son la misma
/// empresa (supuesto de C-20 y C-30, confirmado al arrancar la Fase 9).
model Transferencia {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String              @map("empresa_id") @db.Uuid
  sucursalOrigenId  String              @map("sucursal_origen_id") @db.Uuid
  sucursalDestinoId String              @map("sucursal_destino_id") @db.Uuid
  numero            Int
  estado            EstadoTransferencia @default(ENVIADA)
  notas             String?

  fechaEnvio       DateTime @map("fecha_envio") @db.Timestamptz(6)
  usuarioEnvioId   String   @map("usuario_envio_id") @db.Uuid
  operacionEnvioId String   @map("operacion_envio_id") @db.Uuid

  fechaRecepcion       DateTime? @map("fecha_recepcion") @db.Timestamptz(6)
  usuarioRecepcionId   String?   @map("usuario_recepcion_id") @db.Uuid
  operacionRecepcionId String?   @map("operacion_recepcion_id") @db.Uuid
  notaRecepcion        String?   @map("nota_recepcion")

  anuladaAt       DateTime? @map("anulada_at") @db.Timestamptz(6)
  anuladaPorId    String?   @map("anulada_por_id") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa          Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  origen           Sucursal             @relation("TransferenciaOrigen", fields: [sucursalOrigenId], references: [id], onDelete: Restrict)
  destino          Sucursal             @relation("TransferenciaDestino", fields: [sucursalDestinoId], references: [id], onDelete: Restrict)
  usuarioEnvio     Usuario              @relation("TransferenciaEnviadaPor", fields: [usuarioEnvioId], references: [id], onDelete: Restrict)
  usuarioRecepcion Usuario?             @relation("TransferenciaRecibidaPor", fields: [usuarioRecepcionId], references: [id], onDelete: Restrict)
  anuladaPor       Usuario?             @relation("TransferenciaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  lineas           LineaTransferencia[]
  movimientos      MovimientoStock[]

  @@unique([empresaId, numero])
  @@index([empresaId, sucursalOrigenId, estado])
  @@index([empresaId, sucursalDestinoId, estado])
  @@map("transferencia")
}

/// Una línea: cuánto salió de un insumo y cuánto llegó.
///
/// `cantidadBaseRecibida` es null mientras está en tránsito. La diferencia
/// (enviada − recibida) es la merma por "Diferencia en transferencia" que se
/// registra en el destino al recibir.
model LineaTransferencia {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId       String @map("empresa_id") @db.Uuid
  transferenciaId String @map("transferencia_id") @db.Uuid
  insumoId        String @map("insumo_id") @db.Uuid

  /// Lo que tipeó quien envió, en qué unidad, y el factor (snapshot).
  cantidadIngresada Decimal @map("cantidad_ingresada") @db.Decimal(18, 6)
  unidadIngresadaId String  @map("unidad_ingresada_id") @db.Uuid
  factorConversion  Decimal @map("factor_conversion") @db.Decimal(20, 10)

  cantidadBaseEnviada  Decimal  @map("cantidad_base_enviada") @db.Decimal(18, 6)
  cantidadBaseRecibida Decimal? @map("cantidad_base_recibida") @db.Decimal(18, 6)

  /// El costo promedio al ENVIAR, congelado. La entrada en el destino y la
  /// merma por diferencia usan este mismo costo: la mercadería viaja al
  /// costo, no se revaloriza en el camino.
  costoUnitario Decimal? @map("costo_unitario") @db.Decimal(18, 4)

  transferencia   Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)
  insumo          Insumo        @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  unidadIngresada UnidadMedida  @relation(fields: [unidadIngresadaId], references: [id], onDelete: Restrict)

  @@unique([transferenciaId, insumoId])
  @@index([insumoId])
  @@map("linea_transferencia")
}
