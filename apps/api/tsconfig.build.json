{
  // Configuración SOLO para generar los archivos de dist/.
  // El tsconfig.json principal es el que usan el editor, ESLint y `typecheck`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  // A producción va solo src/. Los tests, el seed y la config del CLI de
  // Prisma son herramientas de desarrollo.
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "prisma/**",
    "test/**",
    "prisma.config.ts",
    "vitest.config.ts"
  ]
}
