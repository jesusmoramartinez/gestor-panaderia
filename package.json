{
  "name": "gestor-panaderia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gesti\u00f3n para panader\u00eda \u2014 control de stock de materia prima",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @panaderia/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:vercel": "pnpm --filter @panaderia/shared build && pnpm --filter @panaderia/api build && pnpm --filter @panaderia/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "pnpm --filter @panaderia/e2e test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U panaderia -d panaderia",
    "db:generate": "pnpm --filter @panaderia/api db:generate",
    "db:migrate": "pnpm --filter @panaderia/api db:migrate",
    "db:seed": "pnpm --filter @panaderia/api db:seed",
    "db:studio": "pnpm --filter @panaderia/api db:studio",
    "db:reset": "pnpm --filter @panaderia/api db:reset",
    "db:backup": "./scripts/backup.sh",
    "db:restaurar": "./scripts/restaurar.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1"
  }
}
