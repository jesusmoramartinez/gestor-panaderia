# Copiá este archivo a .env y ajustá lo que haga falta:
#   cp .env.example .env
#
# .env NO se commitea (está en .gitignore): es donde viven las contraseñas.
# Este .env.example sí se commitea, para que cualquiera sepa qué variables
# hacen falta sin tener que adivinarlas.

# === PostgreSQL (lo usa docker-compose.yml) ===
POSTGRES_USER=panaderia
POSTGRES_PASSWORD=panaderia_dev
POSTGRES_DB=panaderia
POSTGRES_PORT=5432

# === API ===
NODE_ENV=development
PORT=3000

# Cadena de conexión que usa la API. Tiene que coincidir con las variables
# de arriba. Formato: postgresql://usuario:contraseña@host:puerto/base
DATABASE_URL=postgresql://panaderia:panaderia_dev@localhost:5432/panaderia

# =============================================================================
# PRODUCCIÓN (VPS de DigitalOcean, con Docker y Caddy). En desarrollo NO hace
# falta ninguna de estas: todas tienen un valor por defecto que sirve en tu
# máquina.
# En el servidor NO van en este archivo: van en /srv/panaderia/app.env (dueño
# root, permisos 600), y las fijas, en el compose.yaml. Paso a paso:
# docs/deploy-vps.md
# =============================================================================

# En el servidor la base es el contenedor "db" de la red interna:
# DATABASE_URL=postgresql://panaderia:<clave generada en el servidor>@db:5432/panaderia

# Cuánto escriben los logs: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Conexiones a la base por proceso. En el VPS hay un solo proceso: 10 sobra.
# DB_POOL_MAX=10

# Detrás de Caddy, la IP real viene en X-Forwarded-For.
# TRUST_PROXY=true

# Pedidos por minuto por IP (0 = sin límite).
# LIMITE_PEDIDOS_POR_MINUTO=600

# Carpeta con la web compilada: si está, la API también sirve las pantallas.
# En la imagen de Docker ya viene puesta (/app/web).
# WEB_DIR=/app/web
