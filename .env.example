# Copiá este archivo a .env y ajustá lo que haga falta:
#   cp .env.example .env
#
# .env NO se commitea (está en .gitignore): es donde viven las contraseñas.
# Este .env.example sí se commitea, para que cualquiera sepa qué variables
# hacen falta sin tener que adivinarlas.

# === PostgreSQL (lo usa docker-compose.yml) ===
POSTGRES_USER=panaderia
POSTGRES_PASSWORD=panaderia_dev
POSTGRES_DB=panaderia
POSTGRES_PORT=5432

# === API ===
NODE_ENV=development
PORT=3000

# Cadena de conexión que usa la API. Tiene que coincidir con las variables
# de arriba. Formato: postgresql://usuario:contraseña@host:puerto/base
DATABASE_URL=postgresql://panaderia:panaderia_dev@localhost:5432/panaderia

# =============================================================================
# PRODUCCIÓN (Vercel + Supabase). En desarrollo NO hace falta ninguna de estas:
# todas tienen un valor por defecto que sirve en tu máquina.
# En producción NO van en un archivo: se cargan en el panel de Vercel
# (Settings → Environment Variables). Paso a paso: docs/deploy-vercel-supabase.md
# =============================================================================

# La conexión de la API en Supabase: el pooler en modo TRANSACTION (puerto 6543).
# DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# La conexión para las MIGRACIONES: el pooler en modo SESSION (puerto 5432).
# DIRECT_URL=postgresql://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Cuánto escriben los logs: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Conexiones por proceso. En Vercel cada función es un proceso: va 1.
# DB_POOL_MAX=1

# Detrás del proxy de Vercel, la IP real viene en X-Forwarded-For.
# TRUST_PROXY=true

# Pedidos por minuto por IP (0 = sin límite). En Vercel el freno real es el
# firewall de Vercel; este es la segunda línea.
# LIMITE_PEDIDOS_POR_MINUTO=600
